# Copy to .env (docker-compose reads it for ${VAR} substitution), then fill APP_KEY.
# Generate a key:  php artisan key:generate --show

APP_KEY=
APP_URL=http://localhost:8000

DB_DATABASE=tirtanirwana
DB_USERNAME=tirtanirwana
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# Media storage. Leave FILESYSTEM_DISK=local for local disk, or set your
# Cloudinary creds (CLOUDINARY_CLOUD_NAME is also baked into the frontend at build).
FILESYSTEM_DISK=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_URL=

# Mail (default "log" writes to storage/logs; set SMTP for real delivery)
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@tirtanirwana.id
